# Copy to server/.env (preferred) or project-root .env
# Never commit real tokens or secrets.

PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/itcs_fbr?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173

# Sandbox only
FBR_ENVIRONMENT=sandbox
FBR_API_TOKEN=YOUR_ACTUAL_SANDBOX_BEARER_TOKEN
FBR_VALIDATE_URL=https://gw.fbr.gov.pk/di_data/v1/di/validateinvoicedata_sb
FBR_SUBMIT_URL=https://gw.fbr.gov.pk/di_data/v1/di/postinvoicedata_sb
FBR_TIMEOUT_MS=30000

# Microsoft Entra ID (Azure AD) — single-tenant Sign in with Microsoft
# Directory (tenant) ID and Application (client) ID from Azure Portal app registration
AZURE_AD_TENANT_ID=your-tenant-guid
AZURE_AD_CLIENT_ID=your-app-client-guid
# Audience for tokens (defaults to CLIENT_ID). Use api://CLIENT_ID if you expose an API scope.
# AZURE_AD_AUDIENCE=your-app-client-guid

# Automated tests only — never set true in production
# AUTH_DISABLED=false

# Optional client build-time API base (defaults to /api with Vite proxy)
# VITE_API_BASE_URL=http://localhost:5000/api
